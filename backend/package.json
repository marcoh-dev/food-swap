{
	"name": "backend",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"build": "nest build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
		"lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:integration": "vitest run --config vitest.config.integration.ts",
		"typeorm": "typeorm-ts-node-commonjs -d ./src/data-source.ts",
		"migration:generate": "typeorm-ts-node-commonjs -d ./src/data-source.ts migration:generate",
		"migration:run": "pnpm typeorm migration:run",
		"migration:revert": "pnpm typeorm migration:revert",
		"migration:show": "pnpm typeorm migration:show",
		"migration:run:prod": "typeorm migration:run -d dist/data-source.js",
		"places:build": "node scripts/build-places.mjs",
		"seed:mock": "ts-node src/seeds/mock/seed.ts",
		"seed:mock:live": "DOTENV_CONFIG_PATH=.env.live ts-node src/seeds/mock/seed.ts",
		"seed:mock:remove": "ts-node src/seeds/mock/seed.ts --remove"
	},
	"dependencies": {
		"@nestjs/common": "^12.6.0",
		"@nestjs/config": "^12.1.1",
		"@nestjs/core": "^12.6.0",
		"@nestjs/jwt": "^12.0.5",
		"@nestjs/mapped-types": "^12.0.1",
		"@nestjs/passport": "^12.0.2",
		"@nestjs/platform-express": "^12.6.0",
		"@nestjs/platform-socket.io": "^12.6.0",
		"@nestjs/schedule": "^12.0.4",
		"@nestjs/throttler": "^6.8.0",
		"@nestjs/typeorm": "^12.0.3",
		"@nestjs/websockets": "^12.6.0",
		"bcrypt": "^6.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"dotenv": "^18.0.10",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"socket.io": "^4.8.4",
		"typeorm": "^1.1.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@nestjs/cli": "^12.0.15",
		"@nestjs/schematics": "^12.0.16",
		"@nestjs/testing": "^12.6.0",
		"@types/bcrypt": "^6.0.0",
		"@types/express": "^5.0.6",
		"@types/node": "^24.19.2",
		"@types/passport-jwt": "^4.0.1",
		"@types/passport-local": "^1.0.38",
		"@types/supertest": "^7.2.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"supertest": "^7.3.2",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.74.0",
		"vitest": "^5.1.1"
	}
}
