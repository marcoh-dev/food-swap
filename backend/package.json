{
	"name": "backend",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"build": "nest build",
		"format": "prettier --write .",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
		"lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-integration.json",
		"typeorm": "typeorm-ts-node-commonjs -d ./src/data-source.ts",
		"migration:generate": "typeorm-ts-node-commonjs -d ./src/data-source.ts migration:generate",
		"migration:run": "pnpm typeorm migration:run",
		"migration:revert": "pnpm typeorm migration:revert",
		"migration:show": "pnpm typeorm migration:show",
		"migration:run:prod": "typeorm migration:run -d dist/data-source.js",
		"places:build": "node scripts/build-places.mjs",
		"seed:mock": "ts-node src/seeds/mock/seed.ts",
		"seed:mock:live": "DOTENV_CONFIG_PATH=.env.live ts-node src/seeds/mock/seed.ts",
		"seed:mock:remove": "ts-node src/seeds/mock/seed.ts --remove"
	},
	"dependencies": {
		"@nestjs/common": "^12.4.2",
		"@nestjs/config": "^12.1.1",
		"@nestjs/core": "^12.4.2",
		"@nestjs/jwt": "^12.0.4",
		"@nestjs/mapped-types": "^12.0.1",
		"@nestjs/passport": "^12.0.1",
		"@nestjs/platform-express": "^12.4.2",
		"@nestjs/platform-socket.io": "^12.4.2",
		"@nestjs/schedule": "^12.0.3",
		"@nestjs/typeorm": "^12.0.3",
		"@nestjs/websockets": "^12.4.2",
		"bcrypt": "^6.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"dotenv": "^18.0.3",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"socket.io": "^4.8.4",
		"typeorm": "^1.1.2"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^9.39.5",
		"@nestjs/cli": "^12.0.12",
		"@nestjs/schematics": "^12.0.13",
		"@nestjs/testing": "^12.4.2",
		"@types/bcrypt": "^6.0.0",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.19.2",
		"@types/passport-jwt": "^4.0.1",
		"@types/passport-local": "^1.0.38",
		"@types/supertest": "^7.2.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^17.14.0",
		"jest": "^30.5.2",
		"prettier": "^3.9.10",
		"source-map-support": "^0.5.21",
		"supertest": "^7.3.2",
		"ts-jest": "^29.4.15",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
