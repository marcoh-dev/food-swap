DATABASE_URL=postgresql://<user>:<password>@<host>.eu-central-1.aws.neon.tech/<database>?sslmode=verify-full
# Optional: a SELECT-only role (readonly_user) for checks against the live database
DATABASE_URL_READONLY=postgresql://readonly_user:<password>@<host>.eu-central-1.aws.neon.tech/<database>?sslmode=verify-full
SEED_PASSWORD='<live mock password>'
