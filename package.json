{
	"name": "food-swap",
	"private": true,
	"workspaces": [
		"backend",
		"frontend"
	],
	"scripts": {
		"dev": "concurrently -n backend,frontend \"npm run dev -w backend\" \"npm run dev -w frontend\"",
		"format": "npm run format --workspaces",
		"lint": "npm run lint --workspaces",
		"build": "npm run build --workspaces"
	},
	"devDependencies": {
		"concurrently": "^9.2.5"
	}
}
